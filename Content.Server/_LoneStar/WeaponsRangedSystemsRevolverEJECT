using Content.Shared.Weapons.Ranged.Components;
using Content.Shared.Weapons.Ranged.Events;
using Content.Shared.Weapons.Ranged.Systems;

namespace Content.Server.Weapons.Ranged.Systems;

/// <summary>
/// System that handles automatic shell ejection for revolvers equipped with the RevolverEjectOnShotComponent.
/// </summary>
public sealed class RevolverEjectOnShotSystem : EntitySystem
{
    [Dependency] private readonly SharedGunSystem _gunSystem = default!;

    public override void Initialize()
    {
        base.Initialize();
        
        // Subscribe to the GunShotEvent which is raised after a gun fires
        SubscribeLocalEvent<RevolverEjectOnShotComponent, GunShotEvent>(OnGunShot);
    }

    /// <summary>
    /// Ejects spent cartridges from the revolver after firing.
    /// </summary>
    private void OnGunShot(EntityUid uid, RevolverEjectOnShotComponent component, ref GunShotEvent args)
    {
        // Get the revolver ammo provider component
        if (!TryComp<RevolverAmmoProviderComponent>(uid, out var revolver))
            return;

        // Get the gun coordinates for ejecting casings
        var gunCoordinates = Transform(uid).Coordinates;

        // Iterate through the chambers and eject spent cartridges
        for (var i = 0; i < revolver.Capacity; i++)
        {
            // Check if this chamber has a cartridge entity
            if (revolver.AmmoSlots[i] == null)
                continue;

            var cartridgeEntity = revolver.AmmoSlots[i]!.Value;

            // Only eject if it's a spent cartridge
            if (TryComp<CartridgeAmmoComponent>(cartridgeEntity, out var cartridge) && cartridge.Spent)
            {
                // Remove it from the revolver's container
                Containers.Remove(cartridgeEntity, revolver.AmmoContainer);
                
                // Eject the cartridge (this handles the throw physics and sound)
                _gunSystem.EjectCartridge(cartridgeEntity, playSound: true);
                
                // Clear the slot
                revolver.AmmoSlots[i] = null;
                revolver.Chambers[i] = null;
            }
        }

        // Dirty the component so the client gets the updated state
        Dirty(uid, revolver);
    }
}